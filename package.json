{
  "name": "ai-call-center-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-independent outbound IVR and AI call-center integration starter",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:prod": "node src/server.js",
    "test": "node --test test/**/*.js",
    "test:kokoro-local": "node --env-file-if-exists=.env scripts/test-kokoro-local.mjs",
    "simulate:smartping-stream": "node --env-file-if-exists=.env scripts/smartping-stream-simulator.mjs",
    "call:smartping-single": "node --env-file-if-exists=.env scripts/place-test-call.mjs",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/database.js && node --check public/app.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.0.7",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
