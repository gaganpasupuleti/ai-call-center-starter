# Phase 4F process-local operator file (NEVER commit a filled copy).
# Copy to .env.phase4f and fill only on the operator machine.
# Do NOT set these live flags on the Railway application.

PHASE4F_OPERATOR_APPROVED=false
PHASE4F_DESTINATION_CONSENTED=false
PHASE4F_ENGLISH_VOICE_REVIEWED=false
PHASE4F_EXPECTED_ENVIRONMENT=speech-e2e
PHASE4F_LANGUAGE=en
PHASE4F_MAX_NETWORK_REQUESTS=1
PHASE4F_APPROVAL_ID=
PHASE4F_APP_SERVICE=smartping-voice-stream-e2e
PHASE4F_APP_BASE_URL=https://smartping-voice-stream-e2e-speech-e2e.up.railway.app

# SmartPing credentials — process-local only for the one-call CLI
SMARTPING_DRY_RUN=true
SMARTPING_LIVE_CALLS_ENABLED=false
SMARTPING_SINGLE_CALL_ENABLED=false
SMARTPING_TEST_PHONE_NUMBER=
SMARTPING_BASE_URL=
SMARTPING_API_TOKEN=
SMARTPING_DID_NUMBER=
SMARTPING_STREAM_URL=

# Optional: override TTS probe targets when generating local voice samples
# VOICE_TTS_PROVIDER=local-cpu
# PIPER_BASE_URL=
# PIPER_ENGLISH_VOICE=en_US-libritts_r-medium
# PIPER_ENGLISH_SPEAKER_ID=0
