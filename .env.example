PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/call-center.db
APP_EXPOSURE_MODE=full

# Keep mock enabled. Do not activate smartping for live calls.
CALL_PROVIDER=mock
PUBLIC_BASE_URL=http://127.0.0.1:8787
WEBHOOK_SECRET=change-this-before-sharing-a-public-webhook
FOLLOW_UP_LINK_PLACEHOLDER=https://example.com/register

# SmartPing VoiceStreaming (fail-closed)
SMARTPING_BASE_URL=
SMARTPING_OUTBOUND_PATH=/agm/at/streaming/campaign/voicebot/call-customer
SMARTPING_API_TOKEN=
SMARTPING_DID_NUMBER=
SMARTPING_STREAM_URL=
SMARTPING_DRY_RUN=true
SMARTPING_LIVE_CALLS_ENABLED=false
SMARTPING_STORE_AUDIO=false

# WebSocket auth:
# - disabled: local development only
# - required: Bearer token required on upgrade (internal simulator)
# - provider-compatible: SmartPing can upgrade without Bearer (Railway public)
SMARTPING_STREAM_AUTH_MODE=disabled
SMARTPING_STREAM_SHARED_SECRET=
SMARTPING_STREAM_MAX_CONNECTIONS=20
SMARTPING_STREAM_MAX_MESSAGE_BYTES=65536
SMARTPING_STREAM_IDLE_TIMEOUT_MS=60000

# Call-status webhook (schema fields partially undocumented)
SMARTPING_WEBHOOK_PATH=/webhooks/smartping/call-status
SMARTPING_WEBHOOK_AUTH_MODE=validation-only
SMARTPING_WEBHOOK_SHARED_SECRET=
SMARTPING_WEBHOOK_MAX_BODY_BYTES=16384
SMARTPING_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
