PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/call-center.db
APP_EXPOSURE_MODE=full

# Keep mock enabled for campaign UI. Do not enable bulk SmartPing dialing.
CALL_PROVIDER=mock
PUBLIC_BASE_URL=http://127.0.0.1:8787
WEBHOOK_SECRET=change-this-before-sharing-a-public-webhook
FOLLOW_UP_LINK_PLACEHOLDER=https://example.com/register

# SmartPing VoiceStreaming (fail-closed)
SMARTPING_BASE_URL=
SMARTPING_OUTBOUND_PATH=/agm/at/streaming/campaign/voicebot/call-customer
SMARTPING_API_TOKEN=
SMARTPING_DID_NUMBER=
SMARTPING_STREAM_URL=
SMARTPING_DRY_RUN=true
SMARTPING_LIVE_CALLS_ENABLED=false
SMARTPING_SINGLE_CALL_ENABLED=false
SMARTPING_TEST_PHONE_NUMBER=
SMARTPING_STORE_AUDIO=false

# Stage 1 playback: pipeline (mock STT/TTS) or fixed-welcome (prerecorded μ-law)
SMARTPING_PLAYBACK_MODE=pipeline
SMARTPING_WELCOME_AUDIO_PATH=

# Phase 4A conversation engine (no LLM). deterministic (default) | mock
VOICE_RESPONSE_ENGINE=deterministic

# Speech-to-text mode.
# mock keeps the existing simulator-compatible STT.
# faster-whisper-streaming connects to our self-hosted Python service.
VOICE_STT_PROVIDER=mock

# Railway private-network WebSocket address.
STT_STREAM_URL=ws://speech-to-text.railway.internal:8000/v1/stream

STT_CONNECT_TIMEOUT_MS=5000
STT_TRANSCRIPT_TIMEOUT_MS=20000
STT_DEFAULT_LANGUAGE=en
STT_MAX_PENDING_AUDIO_BYTES=16000

# Optional shared internal token.
STT_SERVICE_TOKEN=

# Fail-closed live-call gates (required for staging speech-e2e).
# npm run verify:non-live
OUTBOUND_DIALER_LIVE=false

# Voice conversation lifecycle (Phase 4E / 4E.1). Defaults preserve DTMF-only behaviour.
# VOICE_CONVERSATION_ENABLED=false
# VOICE_INTERACTION_MODE=dtmf | voice | voice-dtmf
VOICE_CONVERSATION_ENABLED=false
VOICE_INTERACTION_MODE=dtmf
VOICE_MAX_TURNS=6
VOICE_LISTEN_TIMEOUT_MS=12000
VOICE_IDLE_HANGUP_MS=30000
VOICE_RESPONSE_TIMEOUT_MS=25000
VOICE_PENDING_TRANSCRIPTS_MAX=1
VOICE_IGNORE_INPUT_WHILE_SPEAKING=true

# Local speech simulator:
#   npm run simulate:local-speech -- --mode inject --language en --scenario send_details
#   npm run simulate:local-speech -- --mode audio --language en --scenario send_details
# Audio mode requires private STT/TTS (no transcript injection).

# TTS provider:
# mock   = simulator-safe synthetic audio (default)
# local  = English → Kokoro, Telugu → Piper (self-hosted)
# kokoro = English-only Kokoro
# piper  = Telugu-only Piper
# msedge / edge are rejected at startup (Microsoft online TTS removed)
VOICE_TTS_PROVIDER=mock

KOKORO_BASE_URL=http://kokoro-tts.railway.internal:8880
KOKORO_MODEL=kokoro
KOKORO_DEFAULT_VOICE=af_bella
KOKORO_DEFAULT_SPEED=1.0
KOKORO_PCM_SAMPLE_RATE=24000

PIPER_BASE_URL=http://piper-tts.railway.internal:5000
PIPER_DEFAULT_VOICE=te_IN-padmavathi-medium
PIPER_ALLOWED_VOICES=te_IN-padmavathi-medium,te_IN-venkatesh-medium
PIPER_CONNECT_TIMEOUT_MS=5000
PIPER_REQUEST_TIMEOUT_MS=20000
PIPER_MAX_WAV_BYTES=8388608
PIPER_MAX_TEXT_CHARS=600
PIPER_MAX_CONCURRENT_SYNTHESIS=2

TTS_CONNECT_TIMEOUT_MS=5000
TTS_REQUEST_TIMEOUT_MS=20000
TTS_MAX_TEXT_CHARS=600
TTS_MAX_PCM_BYTES=8388608
TTS_MAX_MULAW_BYTES=160000
TTS_MAX_CONCURRENT_SYNTHESIS=2
TTS_MAX_PENDING_REQUESTS=10
TTS_DEFAULT_SPEED=1.0
TTS_MIN_SPEED=0.75
TTS_MAX_SPEED=1.25

TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_ENTRIES=100
TTS_CACHE_MAX_BYTES=52428800
TTS_CACHE_TTL_MS=3600000

# Outbound dialer TTS (local ops or Railway with dialer surface)
# inherit | mock | local | kokoro | piper
OUTBOUND_TTS_PROVIDER=inherit
OUTBOUND_TTS_VOICE=af_bella
# Uses bundled ffmpeg-static; no system ffmpeg install required.
# When true: Place call works with confirm + SmartPing credentials
# (bypasses classic dry-run/LIVE/SINGLE gates for /api/outbound/call only).
# Also exposes dialer UI + /api/outbound/* under APP_EXPOSURE_MODE=stream-only.
OUTBOUND_DIALER_LIVE=false
# Optional default agent mobile for keypad 9 → live transfer (+91XXXXXXXXXX)
OUTBOUND_AGENT_PHONE=

# WebSocket auth:
# - disabled: local development only
# - required: Bearer token required on upgrade (internal simulator)
# - provider-compatible: SmartPing can upgrade without Bearer (Railway public)
SMARTPING_STREAM_AUTH_MODE=disabled
SMARTPING_STREAM_SHARED_SECRET=
SMARTPING_STREAM_MAX_CONNECTIONS=20
SMARTPING_STREAM_MAX_MESSAGE_BYTES=65536
SMARTPING_STREAM_IDLE_TIMEOUT_MS=60000

# Call-status webhook (schema fields partially undocumented)
SMARTPING_WEBHOOK_PATH=/webhooks/smartping/call-status
SMARTPING_WEBHOOK_AUTH_MODE=validation-only
SMARTPING_WEBHOOK_SHARED_SECRET=
SMARTPING_WEBHOOK_MAX_BODY_BYTES=16384
SMARTPING_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
